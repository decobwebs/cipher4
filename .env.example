# Web3Forms access key for the contact + quote forms.
# Get a free key in ~2 minutes at https://web3forms.com — no account required,
# you just confirm the destination email address.
NUXT_PUBLIC_WEB3FORMS_KEY=your-access-key-here

# Public site URL, used for canonicals, sitemap and Open Graph tags.
NUXT_PUBLIC_SITE_URL=https://cipherfourai.com
